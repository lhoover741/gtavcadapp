# GTAVCAD shared backend environment template
# Copy to .env in local development or configure these values in your host.
# Do not commit real secrets or credentials.

# Flask/runtime
FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
SESSION_DAYS=7
SESSION_COOKIE_SECURE=true
# Leave blank unless you intentionally serve the API from a shared subdomain such as .gtavcad.com.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=Lax

# Shared production database used by gtavcad.app and gtavcad.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gtavcad
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=280

# Public backend URLs/origins
API_BASE_URL=https://api.gtavcad.com
PUBLIC_BASE_URL=https://gtavcad.com
PLATFORM_DOMAIN=gtavcad.app
WEB_ALLOWED_ORIGINS=https://gtavcad.app,https://www.gtavcad.app,https://gtavcad.com,https://www.gtavcad.com
CORS_ALLOWED_ORIGINS=https://gtavcad.app,https://www.gtavcad.app,https://gtavcad.com,https://www.gtavcad.com
SOCKETIO_ALLOWED_ORIGINS=https://gtavcad.app,https://www.gtavcad.app,https://gtavcad.com,https://www.gtavcad.com

# Shared API bearer tokens. Use the same values on every backend instance.
JWT_ISSUER=gtavcad-shared-backend
JWT_AUDIENCE=gtavcad-web-clients
JWT_MAX_AGE_SECONDS=604800
JWT_SALT=replace-with-a-stable-random-token-salt

# Initial platform owner bootstrap. Set only for first deploy/rotation workflows.
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_USERNAME=platformowner
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_INITIAL_PASSWORD=
FORCE_ADMIN_PASSWORD_RESET=false

# Email notifications/contact forms
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=no-reply@example.com
SMTP_PASSWORD=
NOTIFY_EMAIL=admin@example.com

# Mobile/web push provider abstraction
PUSH_PROVIDER=fcm
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_WEB_VAPID_PUBLIC_KEY=

# Optional AI assistant integration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=https://gtavcad.app
